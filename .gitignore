# Credenciales y entorno local
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
.venv/
**/.venv/
node_modules/
**/node_modules/
.next/
**/.next/
__pycache__/
**/__pycache__/
.pytest_cache/
.ruff_cache/
tmp/
material-privado/
# Documentos de estudio y kit con copias privadas: conservar localmente.
output/
*.log

# Configuración personal de herramientas: revisar antes de cualquier publicación.
/opencode.json
# Agentes, comandos, skills y scripts de OpenCode SÍ se versionan (son parte del entorno).
/.opencode/*
!/.opencode/agents/
!/.opencode/commands/
!/.opencode/skills/
!/.opencode/scripts/

# Respaldos de entornos y artefactos de desarrollo locales.
.venv-*/
.venv.*/
.coverage
.coverage.*
htmlcov/
build/
# /build is also a real Next.js source route, not a generated build directory.
!frontend/app/build/
frontend/app/build/*
!frontend/app/build/page.tsx
dist/
*.egg-info/

# Etapa 29: ejecutables, memoria y respaldos locales, nunca versionados.
/.tools/
/.local/

# Sprint31b: salidas locales de TypeScript y navegador.
*.tsbuildinfo
/frontend/playwright-report/
/frontend/test-results/
/frontend/next-env.d.ts
