# Desarrollo local. No copiar credenciales reales al repositorio.
# scripts/local-env.ps1 carga URLs desde .local/postgresql/runtime.json, sin mostrarlas.
# No pegar credenciales bootstrap en runtime ni cambiar tests hacia la base dev.
# Variables efectivas cargadas por scripts: DATABASE_URL y TEST_DATABASE_URL.
# Auth local: UJ_ENV=dev (arranque) o test; UJ_ORIGIN=http://127.0.0.1:3000;
# UJ_ALLOW_INSECURE_LOOPBACK=1 solo dev/test. Tests requieren UJ_TEST_POSTGRES=1.
# UJ_PROXY_SECRET lo genera el setup protegido; UJ_TRUSTED_PROXY_PEERS=127.0.0.1.
# No usar NEXT_PUBLIC para secretos. HTTP dev no recibe credenciales de base test.
# Backend utilizado por Next. No exponer públicamente.
CATALOG_API_URL=http://127.0.0.1:8000
# Configurar manualmente en .env raíz ignorado; jamás pegar la clave en chat/Git.
GROQ_API_KEY=
# Verificado mediante probe real; la disponibilidad depende de cuenta/proveedor.
GROQ_MODEL=openai/gpt-oss-20b
# certifi por defecto; system usa raíces YA confiadas por el SO, sin desactivar TLS.
# Solo cambiar explícitamente si la inspección TLS local requiere ese almacén.
UJ_TLS_TRUST=certifi
