# UpgradeJusto — flujo Docker: copiá este archivo a ".env" (git lo ignora) y corré
# "docker compose up --build". Con todo vacío arranca la demo local con los defaults
# de docker-compose.yml; los valores entre paréntesis son el default que usa compose.

# --- Base de datos (servicio db: PostgreSQL 18 + pgvector) ---
# Admin del contenedor; la clave real de producción nunca va en este archivo.
POSTGRES_ADMIN_USER=postgres
# OBLIGATORIA: poné cualquier clave (sin espacios ni @ : / porque va dentro de DATABASE_URL).
POSTGRES_ADMIN_PASSWORD=
POSTGRES_DB=upgradejusto
# Usuario de la app que crea scripts/docker/db-init.sql; compose arma DATABASE_URL con esto.
UJ_DB_APP_USER=upgradejusto_app
# OBLIGATORIA: poné cualquier clave (sin espacios ni @ : / porque va dentro de DATABASE_URL).
UJ_DB_APP_PASSWORD=

# --- Backend (FastAPI) ---
# dev habilita el origen http local junto con UJ_ALLOW_INSECURE_LOOPBACK=1.
UJ_ENV=dev
UJ_ORIGIN=http://localhost:3000
UJ_ALLOW_INSECURE_LOOPBACK=1
# Solo loopback: requisito de seguridad del proxy interno, no cambiar.
UJ_TRUSTED_PROXY_PEERS=127.0.0.1
# UJ_PROXY_SECRET NO se configura acá: se genera solo en el volumen "secretos".
# Catálogo de demo montado por compose desde ./data/catalogo.
UJ_DEMO_DATA_DIR=/data/catalogo
# Chat (CU08): sin clave el asistente avisa que no está disponible y todo lo demás funciona.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Proveedor del chat: groq (por defecto), ollama o llamacpp (modelo local en 127.0.0.1:8081).
# Con Docker, 127.0.0.1 es el propio contenedor: el modelo local se usa con el backend fuera de Docker.
# UJ_CHAT_PROVIDER=groq
# 1 = el recomendador pide al modelo local que elija entre propuestas ya verificadas.
# Vacío o 0 = orden determinístico. Requiere scripts/llama-local.ps1 corriendo.
# UJ_LOCAL_ADVISOR=0
# Pegar una lista con el modelo local (groq|llamacpp). Sin caída silenciosa a otro proveedor.
# UJ_EXTRACTION_PROVIDER=groq
# certifi = raíces del paquete Python; system = raíces del SO (no desactiva TLS).
UJ_TLS_TRUST=certifi
# Vacío = login con Google deshabilitado.
UJ_GOOGLE_CLIENT_ID=

# --- Frontend (Next.js) ---
# Dentro del contenedor toca escuchar en 0.0.0.0 para que sirva el puerto publicado.
UJ_WEB_HOST=0.0.0.0
# El backend se comparte por loopback (network_mode: service:backend).
CATALOG_API_URL=http://127.0.0.1:8000
