{
  "name": "upgradejusto-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11.19.1 <12"
  },
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "next build",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:curation": "vitest run tests/unit/curation.test.ts tests/unit/safe-exception.test.ts",
    "test:e2e:curation": "playwright test --config=playwright.curation.config.ts",
    "test:e2e": "powershell -NoProfile -File ../scripts/test-browser.ps1"
  },
  "dependencies": {
    "lucide-react": "1.68.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "^27.4.0",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
